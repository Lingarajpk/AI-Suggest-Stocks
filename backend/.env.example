# Copy to backend/.env and fill in. Never commit .env or paste real keys anywhere else.

# demo  = clearly labelled synthetic data (no credentials needed)
# upstox = live Upstox Developer API
DATA_MODE=demo

# From your Upstox app ("AI Stock") at https://account.upstox.com/developer/apps
UPSTOX_API_KEY=your-upstox-api-key
UPSTOX_API_SECRET=your-upstox-api-secret
# Must exactly match the Redirect URL registered on the Upstox app
UPSTOX_REDIRECT_URI=http://localhost:8000/api/auth/upstox/callback
# Optional: a token generated elsewhere. Normally leave blank and use /api/auth/upstox/login
UPSTOX_ACCESS_TOKEN=

# --- Keeping the connection stable (important on hosted servers) ---
# Owner key: only someone who knows it can (re)connect Upstox, so visitors can't replace your token.
ADMIN_KEY=
# Your Upstox user ID (UCC, shown in the Upstox app profile). Tokens from any other account are refused.
UPSTOX_OWNER_USER_ID=
# Daily token without the OTP page: the backend asks Upstox, you tap Approve in the Upstox app.
# Set the app's Notifier URL on account.upstox.com/developer/apps to
#   https://<your-backend-host>/api/auth/upstox/notifier
UPSTOX_AUTO_REQUEST=false
UPSTOX_AUTO_REQUEST_TIME=08:45
# Your backend's public /api/health URL, pinged every 10 min during market hours so free hosting doesn't sleep.
KEEPALIVE_URL=

# Web push (phone/desktop notifications for each device's watchlist). Leave blank: a key pair is
# generated once and stored in Redis. Set only if you want fixed keys.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
PUSH_CONTACT=mailto:you@example.com

# NVIDIA NIM key from https://build.nvidia.com (used for AI explanations of signals)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Live news (Google News RSS). Sentiment uses NVIDIA_API_KEY when set, else a keyword list.
NEWS_ENABLED=true
NEWS_POLL_MINUTES=5
NEWS_LOOKBACK_HOURS=48
NEWS_MAX_SHIFT_PTS=10

# Strongly recommended when hosted: keeps the Upstox token across restarts (free hosts wipe local files).
# Blank = in-process cache and a local token file.
REDIS_URL=

FRONTEND_ORIGIN=http://localhost:3000
# Comma-separated NSE trading symbols (resolved to instrument keys via Upstox's instrument master)
UNIVERSE=RELIANCE,TCS,HDFCBANK,ICICIBANK,INFY,SBIN,BHARTIARTL,ITC,LT,KOTAKBANK,AXISBANK,HINDUNILVR,BAJFINANCE,MARUTI,SUNPHARMA,TATASTEEL
QUOTE_POLL_SECONDS=2
STALE_AFTER_SECONDS=180
UPSTOX_MAX_REQUESTS_PER_SECOND=10
UPSTOX_MAX_REQUESTS_PER_MINUTE=250

# Automatic alerts (market hours only)
ALERTS_ENABLED=true
ALERT_MOVE_LEVELS=2,4
ALERT_FAST_MOVE_PCT=1.0
ALERT_FAST_WINDOW_MINUTES=15
ALERT_COOLDOWN_MINUTES=30
ALERT_SIGNAL_TIMEFRAME=15m
# Optional phone alerts via Telegram: create a bot with @BotFather, then message it once
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
